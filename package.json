{
  "name": "clay-io",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"bun run --cwd frontend dev\" \"cd backend && .venv/bin/uvicorn app.main:app --reload --port 8001\"",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8001",
    "build": "bun run --cwd frontend build",
    "start": "cd backend && .venv/bin/uvicorn app.main:app --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
